{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "juancode-landing",
	"compatibility_date": "2026-08-01",
	"pages_build_output_dir": "public",

	// Base de datos de la agenda (creada con: npx wrangler d1 create juancode-agenda)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "juancode-agenda",
			"database_id": "9a1ae07d-8a8f-492e-9839-9ceb0179dba3",
			"migrations_dir": "migrations"
		}
	],

	"vars": {
		"WHATSAPP_URL": "https://wa.me/573046452629"
	}

	// ADMIN_PASSWORD es un secreto: en local va en .dev.vars y en
	// producción en el panel de Cloudflare Pages.
}
